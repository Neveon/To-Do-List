{
  "name": "@todo/server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for managing to-do items",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../.env --enable-source-maps dist/index.mjs"
  },
  "dependencies": {
    "@todo/shared": "*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
